{
  "name": "@pasarus/pi-vertex",
  "version": "2.1.3",
  "description": "Google Vertex AI provider for Pi coding agent with dynamic model discovery",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "auth.ts",
    "config.ts",
    "discovery.ts",
    "types.ts",
    "utils.ts",
    "models/",
    "streaming/",
    "README.md",
    "CHANGELOG.md",
    "TEST_COVERAGE.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist/ coverage/ .vitest/",
    "build": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "^0.14.4",
    "@google/genai": "^1.42.0",
    "google-auth-library": "^11.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "vertex-ai",
    "gemini",
    "claude",
    "maas"
  ],
  "author": "Samuel Jones, Anten Skrabec, lhl, ssweens",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pasarus/pi-vertex.git"
  },
  "homepage": "https://github.com/Pasarus/pi-vertex#readme",
  "bugs": {
    "url": "https://github.com/Pasarus/pi-vertex/issues"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "ws": "^8.21.0",
    "uuid": "^11.1.1"
  }
}
